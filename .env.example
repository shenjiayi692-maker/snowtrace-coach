# Optional hardening for the standalone Python analysis service.
# Comma-separated hostnames allowed for signed source-video download URLs.
SNOWTRACE_SOURCE_HOSTS=

# Override only when deploying the analysis service without the checked-in model.
SNOWTRACE_POSE_MODEL=analysis/models/pose_landmarker_lite.task

# Shared bearer token for site → analysis job dispatch. Use the same secret as
# ANALYSIS_SERVICE_TOKEN on the Sites runtime.
SNOWTRACE_JOB_TOKEN=

# Shared bearer token for analysis → site callbacks. Defaults to the job token.
SNOWTRACE_CALLBACK_TOKEN=

# Comma-separated Sites hostnames accepted for result callbacks.
SNOWTRACE_CALLBACK_HOSTS=

# Conservative single-container beta limits.
SNOWTRACE_MAX_ACTIVE_JOBS=1
SNOWTRACE_MAX_SOURCE_BYTES=99614720

# Sites runtime values (configure in Sites, not in a checked-in production file):
# ANALYSIS_SERVICE_URL=https://your-analysis-service.example
# ANALYSIS_SERVICE_TOKEN=
# ANALYSIS_SIGNING_SECRET=
# BETA_METRICS_TOKEN=
